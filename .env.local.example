# Copy this file to .env.local and fill in your values.
# In Vercel: add these under Project → Settings → Environment Variables.

# Braze REST API key (needs users.track permission)
BRAZE_API_KEY=your-braze-api-key-here

# Braze instance URL — check your dashboard URL to find your cluster
# Common values: https://rest.iad-01.braze.com  /  https://rest.iad-02.braze.com
BRAZE_INSTANCE_URL=https://rest.iad-01.braze.com
